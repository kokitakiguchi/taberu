# プロジェクトルートの .env サンプル
# `docker compose -f docker-compose.prod.yml` 用の環境変数を定義する。
# 使い方: `cp .env.example .env` してから値を埋める。
# このファイル自体はコミットして OK。`.env` は .gitignore 済み。

# --- 必須 ---
# Postgres スーパーユーザーのパスワード（任意の強いものに変更）
POSTGRES_PASSWORD=change-me

# Anthropic Claude API キー
CLAUDE_API_KEY=sk-ant-xxxx

# --- 任意（デフォルト値あり） ---
# Postgres ユーザー名（デフォルト: postgres）
# POSTGRES_USER=postgres

# Rust ログレベル（デフォルト: info）
# RUST_LOG=info

# フロントエンドを公開するホスト側ポート（デフォルト: 80）
# PORT=80
