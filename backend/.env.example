# devcontainer 内から実行する場合は host.docker.internal を使う
# DATABASE_URL=postgres://postgres:postgres@host.docker.internal/taberu_db
# ローカル（コンテナ外）から実行する場合
DATABASE_URL=postgres://postgres:postgres@localhost/taberu_db
CLAUDE_API_KEY=sk-ant-xxxxx
UPLOAD_DIR=./uploads
RUST_LOG=debug
# CLAUDE_MOCK=1   # コメントアウトを外すとモックモード
# CORS_ORIGIN: trailing slash なし。本番では https://<ドメイン> に変更する
CORS_ORIGIN=http://localhost:5173
